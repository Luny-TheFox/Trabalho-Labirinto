void MontarMatriz (int m[15][15], int movimento, int orientacao, int giros){
    system("clear");
    
    cout << "\n";
    cout << "*--------------------------------------*" << endl;
    cout << "                Giros:    "      << giros << endl;
    cout << "              MOVIMENTOS: " << movimento  << endl;
    cout << "              ORIENTAÇÃO: " << orientacao << endl;
    cout << "*--------------------------------------*" << endl;
    cout << "|              MAPA 1                  |" << endl;
    cout << "*--------------------------------------*" << endl;
    cout << "|          SEJA BEM-VINDO(A)!          |" << endl;
    cout << "|  USE WASD PARA ANDAR PELO LABIRINTO  |" << endl;
    cout << "|            BOA SORTE! :)             |" << endl;
    cout << "*--------------------------------------*" << endl;
    cout << "\n";
    
    for (int i = 0; i < 15; i++) {//Código utilizado para montar a matriz, mostrando os respectivos espaços
        for (int j = 0; j < 15; j++) {
            switch (m[i][j]) {
                case 0: //Espaço em branco, utilizado como espaço livre
                    cout << " "; 
                    break;
                case 1: //Espaço de parede, uma barreira em que não se interagir
                    printf("\033[40m");
                    cout << " "; 
                    printf("\033[0m"); 
                    break;
                case 2: //Espaço do personagem, é o personagem que o jogador controla
                    printf("\033[33m");
                    cout << "X"; 
                    printf("\033[0m");
                    break;
                case 3: //Espaço de caixa, que cai conforme a orientação ao se mover
                    printf("\033[0;46m");
                    cout << " "; 
                    printf("\033[0m");
                    break;
                case 4: //Alavanca, utilizada para mudar a orientação atual
                    printf("\033[0;43m");
                    cout << "L";
                    printf("\033[0m");
                    break;
                case 5: //Porta A Fechada, Fechada em 0º e 180º
                    printf("\033[0;41m");
                    cout << "H";
                    printf("\033[0m");
                    break;
                case 6: //Porta A Aberta, Aberta em 90º e 270º
                    printf("\033[0;42m");
                    cout << "I";
                    printf("\033[0m");
                    break;
                case 7: //Porta B Fechada, Fechada em 90º e 270º
                    printf("\033[0;41m");
                    cout << "Z";
                    printf("\033[0m");
                    break;
                case 8: //Porta B Aberta, Aberta em 0º e 180º
                    printf("\033[0;42m");
                    cout << "|";
                    printf("\033[0m");
                    break;
                case 9: //Saída, chegue para terminar o jogo
                    printf("\033[0;42m");
                    cout << " ";
                    printf("\033[0m");
                    break;
                default: 
                    cout << " ";
            }
        }
        cout << endl;
    }
}

void AbrirPortas(int m[15][15], int orientacao){
    if(orientacao == 180 || orientacao == 0){
        for (int i = 0; i < 15; i++) { 
            for (int j = 0; j < 15; j++) {
                if(m[i][j] == 5){
                    m[i][j] = 6;
                }else if(m[i][j] == 8){
                    m[i][j] = 7;
                }
            }
        }
    }else if(orientacao == 90 || orientacao == 270){
        for (int i = 0; i < 15; i++) { 
            for (int j = 0; j < 15; j++) {
                if(m[i][j] == 7){
                    m[i][j] = 8;
                }else if(m[i][j] == 6){
                    m[i][j] = 5;
                }
            }
        }
    }
}

void GirarMatriz (int matrizOrigem[15][15], int &px, int &py, char input, int alavanca, int &orientacao, int &giros){
    int matrizAuxiliar[15][15];
    
    if(alavanca == 4){
        if(input == 'q'){
            for (int i = 0; i < 15; i++) { //Preenche a "Matriz Auxiliar" com as informações já rotacionadas
                for (int j = 0; j < 15; j++) {
                    matrizAuxiliar[14-j][i] = matrizOrigem[i][j];
                }
            }
            for (int i = 0; i < 15; i++) { //Preenche a "Matriz de Origem" com as informações
                for (int j = 0; j < 15; j++) {
                    matrizOrigem[i][j] = matrizAuxiliar[i][j];
                }
            }
            if(orientacao <= 0){
                orientacao = 270;
            }else{
                orientacao = orientacao - 90;
            }
            giros++;
        }else if(input == 'e'){
            for (int i = 0; i < 15; i++) { //Preenche a "Matriz Auxiliar" com as informações já rotacionadas
                for (int j = 0; j < 15; j++) {
                    matrizAuxiliar[j][14-i] = matrizOrigem[i][j]; // 14 por 15 - 1 pela forma que os espaços são referidos na memória (0,1,2,3,4...,14)
                }
            }
            for (int i = 0; i < 15; i++) { //Preenche a "Matriz de Origem" com as informações
                for (int j = 0; j < 15; j++) {
                    matrizOrigem[i][j] = matrizAuxiliar[i][j];
                }
            }
            if(orientacao >= 270){
                orientacao = 0;
            }else{
                orientacao = orientacao + 90;
            }
            giros++;
        }else{
            return;
        }

        LocalizarJogador(matrizOrigem, px, py);
        Gravidade(matrizOrigem);
    }else{
        return;
    }
}

