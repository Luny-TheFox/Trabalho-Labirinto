void LocalizarJogador (int m[15][15], int &px, int &py){ //Procura o jogador pela matriz
    for (int i = 0; i < 15; i++) { 
        for (int j = 0; j < 15; j++) {
            if(m[i][j] == 2){
                px = i;
                py = j;
                return;
            }
        }
    }
}

void Gravidade(int m[15][15]){
    for (int i = 13; i >= 1; i--) {//Checa a matriz para ver onde possui caixas, transformando elas de valor 3 para 10, os colocando um espaço abaixo
        for (int j = 1; j < 14; j++) {
            if (m[i][j] == 3 && m[i+1][j] == 0) {
                m[i][j] = 0;
                m[i+1][j] = 3;
            }
        }
    }
}

bool PodeAtravessar(int m[15][15], int nx, int ny, int &movimento, int &sair){
    if (m[nx][ny] == 1 || m[nx][ny] == 3 || m[nx][ny] == 5 || m[nx][ny] == 7){ //Proíbe se for uma parede, caixa ou porta fechada
        return false;
    }else if (m[nx][ny] == 9) { //Encerra se for uma saída
        movimento++;
        sair = 1;
        return true;
    }else{
        return true;
    }
}

void AtualizaJogador(int m[15][15], int &pos_atual, int &nx, int &ny, int &px, int &py, int &movimento){
    m[px][py] = pos_atual; //Limpa a posição antiga
    
    pos_atual = m[nx][ny]; //Guarda o que havia na nova posição
    
    //Atualiza a posição do jogador
    px = nx;
    py = ny;

    m[px][py] = 2; //Coloca o jogador na nova posição
    
    movimento++;
}

void Andar(int m[15][15], int &px, int &py, int &pos_atual, int &movimento, int &sair, char direcao){
    int nx = px;
    int ny = py;
    
    if (direcao == 'w'){ //Vê para onde o jogador quer ir
        nx--;
    }else if (direcao == 's'){
        nx++;
    }else if (direcao == 'a'){
        ny--;
    }else if (direcao == 'd'){
        ny++;
    }else{
        return;
    }
    
    if(PodeAtravessar(m, nx, ny, movimento, sair)){
       AtualizaJogador(m, pos_atual, nx, ny, px, py, movimento);
    }else{
        return;
    }
}

